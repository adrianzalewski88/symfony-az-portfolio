{% extends 'dashboard/layout.html.twig' %}

{% block title %}
    Categories Dashboard
{% endblock %}

{% block dashboard_content %}

    {# Flash Messages #}
    {% for message in app.flashes('success') %}

        <div class="alert alert--success">
            {{ message }}
        </div>

    {% endfor %}


    {% for message in app.flashes('error') %}

        <div class="alert alert--danger">
            {{ message }}
        </div>

    {% endfor %}


    {# Category Statistics #}
    <section class="dashboard-stats">

        <article class="stat-card">

            <span class="stat-card__label">
                Total Categories
            </span>

            <strong class="stat-card__value">
                {{ categories|length }}
            </strong>

            <span class="stat-card__trend">
                Skill organization groups
            </span>

        </article>


        <article class="stat-card">

            <span class="stat-card__label">
                Skills Organized
            </span>

            <strong class="stat-card__value">

                {% set totalCategorizedSkills = 0 %}

                {% for category in categories %}
                    {% set totalCategorizedSkills = totalCategorizedSkills + category.skills|length %}
                {% endfor %}

                {{ totalCategorizedSkills }}

            </strong>

            <span class="stat-card__trend">
                Skills assigned to categories
            </span>

        </article>


        <article class="stat-card">

            <span class="stat-card__label">
                Display Order
            </span>

            <strong class="stat-card__value">
                Active
            </strong>

            <span class="stat-card__trend">
                Categories support custom ordering
            </span>

        </article>


        <article class="stat-card">

            <span class="stat-card__label">
                Relationship
            </span>

            <strong class="stat-card__value">
                1:N
            </strong>

            <span class="stat-card__trend">
                Categories → Skills
            </span>

        </article>

    </section>


    {% if categories is empty %}

        <section class="empty-state">

            <div class="empty-state__icon">
                +
            </div>

            <h2>
                No categories yet
            </h2>

            <p>
                Create your first category to start organizing
                your portfolio skills.
            </p>

            <a
                href="{{ path('dashboard_categories_new') }}"
                class="btn btn--primary"
            >
                Add Your First Category
            </a>

        </section>


    {% else %}

        {# Results Header #}
        <div class="category-results-header">

            <div class="category-results-header__summary">

                <strong>
                    {{ categories|length }}
                    {{ categories|length == 1 ? 'category' : 'categories' }}
                </strong>

                <span>
                    in your portfolio
                </span>

            </div>

            <a
                href="{{ path('dashboard_categories_new') }}"
                class="btn btn--primary"
            >
                <span>+</span>
                Add Category
            </a>

        </div>


        {# Category Grid #}
        <section class="category-grid">

            {% for category in categories %}

                {% include 'components/category-card.html.twig' with {
                    category: category
                } %}

            {% endfor %}

        </section>

    {% endif %}

{% endblock %}