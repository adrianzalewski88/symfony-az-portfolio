<article class="category-card">

    <div class="category-card__header">

        <div class="category-card__identity">

            <span class="category-card__eyebrow">
                Category
            </span>

            <h2 class="category-card__name">
                {{ category.name }}
            </h2>

        </div>

        <span class="category-card__order">
            #{{ category.sortOrder }}
        </span>

    </div>


    <div class="category-card__meta">

        <span class="category-card__slug">
            {{ category.slug }}
        </span>

        <span class="category-card__count">

            {{ category.skills|length }}

            {{ category.skills|length == 1 ? 'skill' : 'skills' }}

        </span>

    </div>


    {% if category.description %}

        <p class="category-card__description">
            {{ category.description }}
        </p>

    {% else %}

        <p class="category-card__description category-card__description--empty">
            No description has been added for this category.
        </p>

    {% endif %}


    <div class="category-card__footer">

        <a
            href="{{ path('dashboard_categories_edit', {
                id: category.id
            }) }}"
            class="btn btn--small btn--secondary"
        >
            Edit
        </a>


        <form
            action="{{ path('dashboard_categories_delete', {
                id: category.id
            }) }}"
            method="post"
        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('delete_category_' ~ category.id) }}"
            >

            <button
                type="submit"
                class="btn btn--small btn--danger"
                onclick="return confirm('Are you sure you want to delete this category?');"
            >
                Delete
            </button>
        </form>

    </div>

</article>